<mvc:View
    controllerName="ui5.feedbackform.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="page"
        title="{i18n>title}">

        <content>

            <VBox
                class="feedbackFormWrapper sapUiContentPadding">

                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom">

                    <Title
                        text="{i18n>title}"
                        level="H2"/>

                    <Select
                        id="languageSelect"
                        width="150px"
                        selectedKey="en"
                        change=".onLanguageChange">

                        <items>
                            <core:Item key="en" text="English"/>
                            <core:Item key="de" text="German"/>
                            <core:Item key="ta" text="தமிழ்"/>
                        </items>

                    </Select>

                </HBox>

                <Label
                    text="{i18n>name}"
                    required="true"/>

                <Input
                    id="nameInput"
                    value="{/name}"
                    placeholder="{i18n>namePlaceholder}"/>

                <Label
                    text="{i18n>email}"
                    required="true"
                    class="sapUiSmallMarginTop"/>

                <Input
                    id="emailInput"
                    value="{/email}"
                    type="Email"
                    placeholder="{i18n>emailPlaceholder}"/>

                <Label
                    text="{i18n>subject}"
                    required="true"
                    class="sapUiSmallMarginTop"/>

                <Input
                    id="subjectInput"
                    value="{/subject}"
                    placeholder="{i18n>subjectPlaceholder}"/>

                <Label
                    text="{i18n>message}"
                    required="true"
                    class="sapUiSmallMarginTop"/>

                <TextArea
                    id="messageArea"
                    value="{/message}"
                    rows="5"
                    placeholder="{i18n>messagePlaceholder}"/>

                <Text
                    text="{= ${i18n>totalFeedback} + ': ' + ${/count} }"
                    class="sapUiMediumMarginTop"/>

                <HBox
                    justifyContent="End"
                    class="sapUiMediumMarginTop">

                    <Button
                        text="{i18n>submit}"
                        type="Emphasized"
                        press=".onSubmit"
                        class="sapUiTinyMarginEnd"/>

                    <Button
                        text="{i18n>cancel}"
                        press=".onCancel"/>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>