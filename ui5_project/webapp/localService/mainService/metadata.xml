<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
        <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema Namespace="service.srv.ui5API" xmlns="http://docs.oasis-open.org/odata/ns/edm">
            <Annotation Term="Core.Links">
                <Collection>
                    <Record>
                        <PropertyValue Property="rel" String="author"/>
                        <PropertyValue Property="href" String="https://cap.cloud.sap"/>
                    </Record>
                </Collection>
            </Annotation>
            <EntityContainer Name="EntityContainer">
                <EntitySet Name="teachers" EntityType="service.srv.ui5API.teachers">
                    <NavigationPropertyBinding Path="studRef" Target="students"/>
                </EntitySet>
                <EntitySet Name="students" EntityType="service.srv.ui5API.students">
                    <NavigationPropertyBinding Path="teaRef" Target="teachers"/>
                </EntitySet>
            </EntityContainer>
            <EntityType Name="teachers">
                <Key>
                    <PropertyRef Name="ID"/>
                </Key>
                <Property Name="ID" Type="Edm.String" Nullable="false"/>
                <Property Name="Name" Type="Edm.String"/>
                <Property Name="Email" Type="Edm.String"/>
                <Property Name="Contact" Type="Edm.String"/>
                <Property Name="Salary" Type="Edm.Decimal" Scale="variable"/>
                <NavigationProperty Name="studRef" Type="service.srv.ui5API.students" Partner="teaRef">
                    <ReferentialConstraint Property="studRef_ID" ReferencedProperty="ID"/>
                </NavigationProperty>
                <Property Name="studRef_ID" Type="Edm.String"/>
            </EntityType>
            <EntityType Name="students">
                <Key>
                    <PropertyRef Name="ID"/>
                </Key>
                <Property Name="ID" Type="Edm.String" Nullable="false"/>
                <Property Name="Name" Type="Edm.String"/>
                <Property Name="Email" Type="Edm.String"/>
                <Property Name="Address" Type="Edm.String"/>
                <Property Name="Fees" Type="Edm.String"/>
                <NavigationProperty Name="teaRef" Type="Collection(service.srv.ui5API.teachers)" Partner="studRef"/>
            </EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>